# Copia este archivo como .env y pon tu clave. .env está en .gitignore: nunca se sube al repositorio.

# --- Obligatorio ---
META_MUSE_API_KEY=pega_aqui_tu_clave_de_la_meta_model_api

# --- API y modelos (valores por defecto) ---
MUSE_API_BASE_URL=https://api.meta.ai/v1
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_SAM_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_VOICE_LANGUAGES=Spanish

# --- Fase 1: límites de entrada ---
MAX_VIDEOS=3
MAX_DURATION_SEC=60.0
LAPLACIAN_BLUR_THRESHOLD=80.0

# --- Fase 2: voz + productos ---
MUSE_SPARK_REASONING_PHASE2=low
MUSE_SPARK_PHASE2_VIDEO=1
MUSE_SPARK_PHASE2_VIDEO_FPS=1
MUSE_PHASE2_VERIFY=1
MUSE_PHASE2_VERIFY_MIN_CONFIDENCE=0.7
MUSE_PHASE2_VERIFY_MAX_WINDOWS=6
# CONSULTAR_PRECIO (el objeto entra sin precio) o EXCLUDE (se descarta)
MUSE_MISSING_PRICE_POLICY=CONSULTAR_PRECIO

# --- Fase 3: visión + recorte ---
MUSE_SPARK_REASONING_PHASE3=low
MUSE_PHASE3_MIN_IOU=0.3
MUSE_PHASE3_VERIFY_CUTOUTS=1

# --- Fase 4: estudio fotográfico ---
MUSE_IMAGE_SIZE=1024x1024
MUSE_IMAGE_COST_USD=0.01
MUSE_IMAGE_PARALLEL=6
MUSE_PHASE4_LIFESTYLE=1

# --- Almacenamiento local ---
STORAGE_DIR=storage
